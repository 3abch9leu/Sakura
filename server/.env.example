# Copy to server/.env and paste the key from https://punica.tn/platform/keys
# (starts with pk_live_). Never commit server/.env.
PUNICA_API_KEY=

# Optional: the relay port (default 8787, keep it in sync with environment.ts).
# VOICE_PORT=8787

# Optional: comma-separated origins allowed to ask for a voice session.
# ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
